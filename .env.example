# Server
PORT=8080
APP_ENV=local

# go-whisper sidecar (run separately via Docker or binary)
# See: https://github.com/mutablelogic/go-whisper
GOWHISPER_URL=http://localhost:8081

# Max seconds for full pipeline (download + transcription)
REQUEST_TIMEOUT=120

# Whisper model ID
# Local models (must be pre-downloaded): ggml-tiny.bin, ggml-base.bin, ggml-small.bin, ggml-medium.bin
# OpenAI API (set OPENAI_API_KEY below):  whisper-1
WHISPER_MODEL=ggml-base.bin

# OpenAI API key — used by go-whisper to route transcription to OpenAI instead of a local model.
# When set, change WHISPER_MODEL to whisper-1 and no local model download is needed.
OPENAI_API_KEY=

# Proxy provider: none | scraperapi
PROXY_PROVIDER=none

# Required when PROXY_PROVIDER=scraperapi
# Get your key at https://www.scraperapi.com/
SCRAPER_API_KEY=
