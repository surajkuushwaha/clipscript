# Server
PORT=8080
APP_ENV=local

# go-whisper sidecar (run separately via Docker or binary)
# See: https://github.com/mutablelogic/go-whisper
GOWHISPER_URL=http://localhost:8081

# Max seconds for full pipeline (download + transcription)
REQUEST_TIMEOUT=120

# Whisper model ID
# Local models (must be pre-downloaded): ggml-tiny, ggml-base, ggml-small, ggml-medium
# OpenAI API (set OPENAI_API_KEY below):  whisper-1
WHISPER_MODEL=ggml-base

# OpenAI API key — used by go-whisper to route transcription to OpenAI instead of a local model.
# When set, change WHISPER_MODEL to whisper-1 and no local model download is needed.
OPENAI_API_KEY=

# Optional: path to JSON proxy pool (see config/proxy-pool.example.json; real creds in config/proxy-pool.json, gitignored)
# PROXY_POOL_FILE=config/proxy-pool.json

# Optional: inline JSON proxy pool (same schema as the file)
# PROXY_POOL=

# Local dev only if yt-dlp hits CERTIFICATE_VERIFY_FAILED (insecure)
# YTDLP_NO_CHECK_CERTIFICATES=false

# Optional: persist downloaded audio + transcripts (default off)
# CACHE_ENABLED=false
# CACHE_DIR=./cache
